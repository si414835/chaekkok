{
  "rewrites": [
    { "source": "/book/:isbn", "destination": "/api/page?type=book&id=:isbn" },
    { "source": "/keyword/:word", "destination": "/api/page?type=keyword&id=:word" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
