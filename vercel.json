{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- src public index.html api package.json package-lock.json vite.config.js vercel.json",
  "rewrites": [
    {
      "source": "/book/:isbn",
      "destination": "/api/page?type=book&id=:isbn"
    },
    {
      "source": "/keyword/:word",
      "destination": "/api/page?type=keyword&id=:word"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
